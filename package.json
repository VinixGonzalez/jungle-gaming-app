{
  "name": "jungle-gaming-app",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "audit:lighthouse": "npm run build && node scripts/lighthouse/run.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/home-visual.spec.ts tests/e2e/nft-detail-visual.spec.ts tests/e2e/cart-visual.spec.ts tests/e2e/auth-visual.spec.ts tests/e2e/checkout-visual.spec.ts tests/e2e/account-visual.spec.ts tests/e2e/favorites-visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/home-visual.spec.ts tests/e2e/nft-detail-visual.spec.ts tests/e2e/cart-visual.spec.ts tests/e2e/auth-visual.spec.ts tests/e2e/checkout-visual.spec.ts tests/e2e/account-visual.spec.ts tests/e2e/favorites-visual.spec.ts --update-snapshots",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.89.0",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.5.0",
    "msw": "2.10.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
